# Sentinel Edge Configuration
# Copy this file to .env and fill in your values

# LLM Provider Selection
LLM_PROVIDER=qwen

# Qwen Cloud API (Required)
# Get your key from: https://dashscope.console.aliyun.com/
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# AbuseIPDB Threat Intelligence (Required for MCP)
# Get your free key from: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False
