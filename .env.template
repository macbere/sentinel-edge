# Sentinel Edge Configuration
# Copy this file to .env and fill in your values

# LLM Provider Selection: qwen | claude | offline
LLM_PROVIDER=offline

# Qwen Cloud API (Track 5 Primary)
# Get key from: https://dashscope.console.aliyun.com/
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# Claude API (Optional Backup)
# Get key from: https://console.anthropic.com/
CLAUDE_API_KEY=

# Server Config
HOST=127.0.0.1
PORT=5000
DEBUG=False
